    <changeSet author="fineract" id="5" context="mysql,postgresql">
        <sql><![CDATA[
            ALTER TABLE m_agent
                ADD CONSTRAINT chk_m_agent_status_enum CHECK (status_enum IN (300, 400)),
                ADD CONSTRAINT chk_m_agent_currency_code CHECK (char_length(currency_code) = 3),
                ADD CONSTRAINT chk_m_agent_maximum_cash_in_hand CHECK (maximum_cash_in_hand > 0),
                ADD CONSTRAINT chk_m_agent_max_daily_total CHECK (maximum_daily_total_collection > 0);

            ALTER TABLE m_agent_transaction_limit
                ADD CONSTRAINT chk_m_agent_transaction_limit_type CHECK (transaction_type_enum IN (1, 2)),
                ADD CONSTRAINT chk_m_agent_transaction_limit_single CHECK (maximum_single_amount IS NULL OR maximum_single_amount >= 0),
                ADD CONSTRAINT chk_m_agent_transaction_limit_daily CHECK (maximum_daily_amount IS NULL OR maximum_daily_amount >= 0);

            ALTER TABLE m_agent_settlement
                ADD CONSTRAINT chk_m_agent_settlement_status_enum CHECK (status_enum IN (100, 200, 300, 400, 500)),
                ADD CONSTRAINT chk_m_agent_settlement_currency_code CHECK (char_length(currency_code) = 3),
                ADD CONSTRAINT chk_m_agent_settlement_expected_amount CHECK (expected_amount > 0),
                ADD CONSTRAINT chk_m_agent_settlement_submitted_amount CHECK (submitted_amount > 0);

            ALTER TABLE m_agent_collection_transaction
                ADD CONSTRAINT chk_m_agent_collection_type CHECK (transaction_type_enum IN (1, 2)),
                ADD CONSTRAINT chk_m_agent_collection_status CHECK (status_enum IN (100, 200, 300, 400)),
                ADD CONSTRAINT chk_m_agent_collection_amount CHECK (amount > 0),
                ADD CONSTRAINT chk_m_agent_collection_currency CHECK (char_length(currency_code) = 3),
                ADD CONSTRAINT chk_m_agent_collection_loan_ref
                    CHECK (transaction_type_enum <> 1 OR (loan_id IS NOT NULL AND loan_transaction_id IS NOT NULL)),
                ADD CONSTRAINT chk_m_agent_collection_savings_ref
                    CHECK (transaction_type_enum <> 2 OR (savings_account_id IS NOT NULL AND savings_transaction_id IS NOT NULL));
        ]]></sql>
        <rollback><![CDATA[
            ALTER TABLE m_agent_collection_transaction DROP CONSTRAINT chk_m_agent_collection_savings_ref;
            ALTER TABLE m_agent_collection_transaction DROP CONSTRAINT chk_m_agent_collection_loan_ref;
            ALTER TABLE m_agent_collection_transaction DROP CONSTRAINT chk_m_agent_collection_currency;
            ALTER TABLE m_agent_collection_transaction DROP CONSTRAINT chk_m_agent_collection_amount;
            ALTER TABLE m_agent_collection_transaction DROP CONSTRAINT chk_m_agent_collection_status;
            ALTER TABLE m_agent_collection_transaction DROP CONSTRAINT chk_m_agent_collection_type;

            ALTER TABLE m_agent_settlement DROP CONSTRAINT chk_m_agent_settlement_submitted_amount;
            ALTER TABLE m_agent_settlement DROP CONSTRAINT chk_m_agent_settlement_expected_amount;
            ALTER TABLE m_agent_settlement DROP CONSTRAINT chk_m_agent_settlement_currency_code;
            ALTER TABLE m_agent_settlement DROP CONSTRAINT chk_m_agent_settlement_status_enum;

            ALTER TABLE m_agent_transaction_limit DROP CONSTRAINT chk_m_agent_transaction_limit_daily;
            ALTER TABLE m_agent_transaction_limit DROP CONSTRAINT chk_m_agent_transaction_limit_single;
            ALTER TABLE m_agent_transaction_limit DROP CONSTRAINT chk_m_agent_transaction_limit_type;

            ALTER TABLE m_agent DROP CONSTRAINT chk_m_agent_max_daily_total;
            ALTER TABLE m_agent DROP CONSTRAINT chk_m_agent_maximum_cash_in_hand;
            ALTER TABLE m_agent DROP CONSTRAINT chk_m_agent_currency_code;
            ALTER TABLE m_agent DROP CONSTRAINT chk_m_agent_status_enum;
        ]]></rollback>
    </changeSet>

